{
  "name": "personal-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "build": "node scripts/build-client.ts",
    "start": "node --env-file-if-exists=.env scripts/build-client.ts && node --env-file-if-exists=.env src/server/server.ts",
    "dev": "node --env-file-if-exists=.env scripts/build-client.ts && node --env-file-if-exists=.env --watch src/server/server.ts",
    "test": "node --test tests/*.test.ts"
  }
}
