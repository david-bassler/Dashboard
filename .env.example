TZ=Europe/Berlin
PORT=3000
WEATHER_REFRESH_HOUR=6

ACCUWEATHER_API_KEY=
ACCUWEATHER_LOCATION_KEY=
ACCUWEATHER_LOCATION_NAME=Berlin
ACCUWEATHER_LANGUAGE=de-de

# Public Core Weather API supports 1, 5, 7, 10 or 15 days depending on plan.
# The dashboard target remains 28 days; missing days are reported, never invented.
ACCUWEATHER_FORECAST_DAYS=15
